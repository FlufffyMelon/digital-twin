#!/bin/sh
# Последняя линия защиты от утечки личных данных в git:
# отклоняет коммит, если в нём есть данные, веса или ноутбуки с выводами.
# Подключается через `git config core.hooksPath .githooks`.

MAX_BYTES=1000000
fail=0

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

for f in $files; do
    case "$f" in
        *.json|*.jsonl|*.csv|*.tsv|*.parquet|*.arrow|*.txt.gz|*.zip|*.tar|*.tar.gz|\
        *.safetensors|*.bin|*.pt|*.pth|*.ckpt|*.gguf|*.npz|*.npy|*.pkl|*.out|*.log)
            # requirements*.txt не попадает сюда: шаблона *.txt в списке нет
            echo "pre-commit: файл данных/весов в коммите: $f" >&2
            fail=1
            ;;
    esac

    case "$f" in
        data/README.md) ;;
        data/*|outputs/*|logs/*)
            echo "pre-commit: файл из каталога с личными данными: $f" >&2
            fail=1
            ;;
    esac

    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
        echo "pre-commit: файл больше 1 МБ: $f ($size байт)" >&2
        fail=1
    fi

    case "$f" in
        *.ipynb)
            tmp=$(mktemp)
            git show ":$f" > "$tmp"
            if ! python3 scripts/nbstrip.py --check "$tmp" 2>/dev/null; then
                echo "pre-commit: в ноутбуке остались выводы ячеек: $f" >&2
                echo "            (фильтр nbstrip не настроен? см. README.md)" >&2
                fail=1
            fi
            rm -f "$tmp"
            ;;
    esac
done

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: коммит отклонён. Личные данные и веса в git не кладём." >&2
    exit 1
fi
