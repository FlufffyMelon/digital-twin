#!/bin/sh
# Last line of defence against personal data in git: rejects a commit
# with chat exports, datasets, weights or logs in it.
# Enable with `git config core.hooksPath .githooks`.

MAX_BYTES=1000000
fail=0

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

for f in $files; do
    case "$f" in
        *.json|*.jsonl|*.csv|*.tsv|*.parquet|*.arrow|*.zip|*.tar|*.tar.gz|*.ipynb|\
        *.safetensors|*.bin|*.pt|*.pth|*.ckpt|*.gguf|*.npz|*.npy|*.pkl|*.out|*.log)
            echo "pre-commit: data or weights file in the commit: $f" >&2
            fail=1
            ;;
    esac

    case "$f" in
        data/README.md) ;;
        data/*|outputs/*|logs/*|backup/*)
            echo "pre-commit: file from a personal data folder: $f" >&2
            fail=1
            ;;
    esac

    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
        echo "pre-commit: file over 1 MB: $f ($size bytes)" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "pre-commit: commit rejected. Chats, datasets and weights stay out of git." >&2
    exit 1
fi
