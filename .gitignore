# Allow-list: only code and documentation go to git.
# Chats, datasets and weights are personal data and never belong here,
# so any file of an unknown type is ignored by default.
*
!*/
!*.py
!*.sh
!*.md
!LICENSE
!pyproject.toml
!uv.lock
!.python-version
!.gitignore
!.githooks/*
!assets/*.png
!assets/*.jpg

# Folders git does not look into at all (not even for *.py inside).
# data/ — entirely, except its README.
data/**
!data/README.md
outputs/
logs/
backup/
.venv/
wandb/
unsloth_compiled_cache/
huggingface_tokenizers_cache/
__pycache__/
.claude/
